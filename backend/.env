PROJECT_NAME="NatWest Core Banking Platform"
ENVIRONMENT="development"
DEBUG=True
INSTANCE_ID="api-instance-1"

# Database (PostgreSQL only, no Redis)
POSTGRES_SERVER="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="banking_user"
POSTGRES_PASSWORD="banking_secure_password_2026"
POSTGRES_DB="core_banking"

# Security
JWT_SECRET="super-secret-jwt-key-natwest-production-ready-32char"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Fraud Detection Engine Thresholds
FRAUD_LARGE_AMOUNT_THRESHOLD_PENCE=1000000
FRAUD_RAPID_REPEAT_WINDOW_SECONDS=60
FRAUD_RAPID_REPEAT_MAX_COUNT=3
FRAUD_ODD_HOURS_START=1
FRAUD_ODD_HOURS_END=5

# Mock Payment Gateway
MOCK_GATEWAY_URL="http://gateway:8001"
GATEWAY_TIMEOUT_SECONDS=3.0
GATEWAY_MAX_RETRIES=3
